Screen {
    layout: vertical;
}

Header {
    dock: top;
    height: 3;
    content-align: center middle;
    background: $primary;
    color: $text;
}

Footer {
    dock: bottom;
    height: 1;
}

#main-container {
    layout: horizontal;
    height: 1fr;
}

#left-pane {
    width: 60%;
    height: 1fr;
    border-right: solid $primary;
    padding: 1;
}

#right-pane {
    width: 40%;
    height: 1fr;
    padding: 1;
}

Input {
    margin-bottom: 1;
}

DataTable {
    height: 1fr;
}

#player-bar {
    dock: bottom;
    height: 3;
    border-top: solid $primary;
    background: $panel;
    content-align: center middle;
    text-align: center;
}
